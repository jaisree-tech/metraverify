# Default: SQLite, no install needed. Leave this line as-is to run locally instantly.
DATABASE_URL=sqlite:///./metraverify.db

# If you later want Postgres (e.g. on Render's managed database), replace the
# line above with something like:
# DATABASE_URL=postgresql://metra_user:metra_pass@localhost:5432/metraverify

SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
